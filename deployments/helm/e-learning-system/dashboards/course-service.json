{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Response time distribution",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_bucket{app=\"course-service\", instance=~\"$instance\"}[$__rate_interval])) by (le)",
          "format": "heatmap"
        }
      ]
    },
    {
      "title": "Latency \u2014 p50 / p90 / p99",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{app=\"course-service\", instance=~\"$instance\"}[$__rate_interval])) by (le, path))",
          "legendFormat": "{{path}} p50"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket{app=\"course-service\", instance=~\"$instance\"}[$__rate_interval])) by (le, path))",
          "legendFormat": "{{path}} p90"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{app=\"course-service\", instance=~\"$instance\"}[$__rate_interval])) by (le, path))",
          "legendFormat": "{{path}} p99"
        }
      ]
    },
    {
      "title": "RPS",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"course-service\", instance=~\"$instance\"}[$__rate_interval])) by (path)",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "title": "Response code ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 400
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"course-service\", instance=~\"$instance\"}[$__rate_interval])) by (status_code)",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "title": "RPS per endpoint",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "options": {
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"course-service\", instance=~\"$instance\"}[$__rate_interval])) by (path, method)",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": [
    "course-service",
    "prometheus"
  ],
  "templating": {
    "list": [
      {
        "hide": 0,
        "label": "datasource",
        "name": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": null,
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "includeAll": true,
        "label": "instance",
        "multi": true,
        "name": "instance",
        "query": "label_values(up{app=\"course-service\"}, instance)",
        "refresh": 1,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "course-service dashboard",
  "uid": "course-service-dashboard"
}